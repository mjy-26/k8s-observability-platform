      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_requests_total{path=\"/work\", status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_requests_total{path=\"/work\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "error ratio",
          "refId": "A"
        }
      ],
      "title": "Error Ratio (RED: Errors)",
      "type": "stat"
